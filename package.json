{
  "name": "@miyaoka/claude-hooks",
  "version": "0.1.0",
  "description": "Hook scripts for Claude Code",
  "bin": {
    "claude-hooks": "./src/index.ts"
  },
  "type": "module",
  "module": "src/index.ts",
  "scripts": {
    "dev": "bun run src/index.ts",
    "dev:example": "bun run src/index.ts --input examples/input.json --config examples/hooks.config.json",
    "lint": "oxlint --type-aware",
    "fix": "oxlint --type-aware --fix && oxfmt",
    "typecheck": "tsgo",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@typescript/native-preview": "7.0.0-dev.20260605.1",
    "lefthook": "^2.1.9",
    "oxfmt": "^0.53.0",
    "oxlint": "^1.68.0",
    "oxlint-tsgolint": "^0.23.0"
  }
}
